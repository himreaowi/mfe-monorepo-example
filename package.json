{
  "name": "@org/mfe-monorepo-template",
  "version": "0.0.0",
  "private": true,
  "description": "React microfrontend monorepo template (pnpm workspaces + Nx + Rspack + Module Federation 2)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "prettier": "@org/prettier-config",
  "mfe": {
    "tools": {
      "mockApi": {
        "offset": 0,
        "package": "@org/mock-api"
      },
      "mockVendor": {
        "offset": 1,
        "package": "@org/mock-vendor"
      }
    }
  },
  "scripts": {
    "check": "node tools/scripts/bin/check.js",
    "apps": "node tools/scripts/bin/list-apps.js",
    "validate-manifest": "node tools/scripts/bin/validate-manifest.js",
    "lint": "node tools/scripts/bin/check.js && nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "e2e": "node tools/scripts/bin/e2e.js",
    "e2e:intranet": "node tools/scripts/bin/e2e.js --zone=intranet",
    "e2e:internet": "node tools/scripts/bin/e2e.js --zone=internet",
    "dev:intranet": "nx run-many -t dev --projects=tag:zone:intranet --parallel=100 --outputStyle=stream",
    "dev:internet": "nx run-many -t dev --projects=tag:zone:internet --parallel=100 --outputStyle=stream",
    "gen:shell": "node tools/generators/bin/gen.js shell",
    "gen:remote": "node tools/generators/bin/gen.js remote",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@org/prettier-config": "workspace:*",
    "nx": "catalog:",
    "prettier": "catalog:"
  }
}
