{
  "name": "@org/mfe-monorepo-example",
  "version": "0.0.0",
  "private": true,
  "description": "MFE monorepo example: Staff Portal (intranet) and Citizen Portal (internet), built from the React microfrontend monorepo template",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "prettier": "@org/prettier-config",
  "mfe": {
    "tools": {
      "mockApi": {
        "offset": 0,
        "package": "@org/mock-api"
      },
      "mockVendor": {
        "offset": 1,
        "package": "@org/mock-vendor"
      },
      "exampleVendors": {
        "offset": 2,
        "package": "@org/example-vendors",
        "description": "Example vendor demo servers (intranet: Acme Service Desk, internet: Bright Payments)"
      }
    },
    "zones": {
      "internet": {
        "defaultShell": "citizen"
      }
    }
  },
  "scripts": {
    "check": "node tools/scripts/bin/check.js",
    "apps": "node tools/scripts/bin/list-apps.js",
    "validate-manifest": "node tools/scripts/bin/validate-manifest.js",
    "dev-manifest": "node tools/scripts/bin/dev-manifest.js",
    "lint": "node tools/scripts/bin/check.js && nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "e2e": "node tools/scripts/bin/e2e.js",
    "e2e:intranet": "node tools/scripts/bin/e2e.js --zone=intranet",
    "e2e:internet": "node tools/scripts/bin/e2e.js --zone=internet",
    "dev:intranet": "node tools/scripts/bin/dev.js --zone=intranet",
    "dev:internet": "node tools/scripts/bin/dev.js --zone=internet",
    "gen:shell": "node tools/generators/bin/gen.js shell",
    "gen:remote": "node tools/generators/bin/gen.js remote",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@org/prettier-config": "workspace:*",
    "nx": "catalog:",
    "prettier": "catalog:"
  }
}
