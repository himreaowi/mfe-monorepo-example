{
  "name": "@org/use-api",
  "version": "0.1.0",
  "private": true,
  "description": "Data-fetching hooks for remotes: useApi (load with loading/success/error, abort, reload) and useSubmit (state-changing requests). No shared state, so not a runtime singleton.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
