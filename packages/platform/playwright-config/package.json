{
  "name": "@org/playwright-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Playwright setup for zone e2e suites: config factory (desktop + 375px mobile, zone dev servers), fixtures (console errors), axe WCAG 2.2 AA helper",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./test": {
      "types": "./src/test.d.ts",
      "default": "./src/test.js"
    },
    "./zone": {
      "types": "./src/zone.d.ts",
      "default": "./src/zone.js"
    },
    "./global-setup": "./src/global-setup.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.js\""
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@org/eslint-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
