{
  "name": "@org/http-client",
  "version": "0.1.0",
  "private": true,
  "description": "Small axios wrapper on the fetch adapter (JSON helpers, typed errors, timeout, 401 hook) with a runtime-injected base URL and an apiRoutes pattern",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  },
  "dependencies": {
    "axios": "catalog:"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
