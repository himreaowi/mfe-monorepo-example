{
  "name": "@org/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React UI: the in-house component library (Button, Link, form fields, Dialog, Alert, Card, Badge, Spinner, Table, Tabs, \u2026) and the shell building blocks (Brand, SkipLink, ThemeToggle, ThemeProvider, useMenuDisclosure, useFitLayout, RemoteFallback, ConnectionRequired). Native HTML first, design tokens only. Tier-1 Module Federation singleton. Storybook is dev-only.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "storybook": "node .storybook/run.js",
    "build-storybook": "storybook build --quiet --output-dir storybook-static",
    "test-ui": "playwright test -c visual/playwright.config.ts"
  },
  "nx": {
    "tags": [
      "type:package"
    ],
    "targets": {
      "storybook": {
        "continuous": true,
        "cache": false
      },
      "build-storybook": {
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      },
      "test-ui": {
        "cache": false,
        "dependsOn": [
          "build-storybook"
        ]
      }
    }
  },
  "dependencies": {
    "@org/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@storybook/react-webpack5": "catalog:",
    "@swc/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "css-loader": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "mini-css-extract-plugin": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "sass": "catalog:",
    "sass-loader": "catalog:",
    "storybook": "catalog:",
    "swc-loader": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:"
  }
}
