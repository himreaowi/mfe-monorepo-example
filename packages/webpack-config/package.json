{
  "name": "@org/webpack-config",
  "version": "0.1.0",
  "private": true,
  "description": "webpack 5 + Module Federation 2 config factories: createShellConfig / createRemoteConfig",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./tier1": {
      "types": "./src/index.d.ts",
      "default": "./src/tier1.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=120000 \"src/**/*.test.js\""
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  },
  "dependencies": {
    "@module-federation/enhanced": "catalog:",
    "@org/pwa": "workspace:*",
    "@swc/core": "catalog:",
    "copy-webpack-plugin": "catalog:",
    "css-loader": "catalog:",
    "css-minimizer-webpack-plugin": "catalog:",
    "html-webpack-plugin": "catalog:",
    "lightningcss": "catalog:",
    "mini-css-extract-plugin": "catalog:",
    "sass": "catalog:",
    "sass-loader": "catalog:",
    "swc-loader": "catalog:",
    "terser-webpack-plugin": "catalog:"
  },
  "peerDependencies": {
    "webpack": "^5.101.0",
    "webpack-dev-server": "^6.0.0"
  },
  "devDependencies": {
    "@org/auth": "workspace:*",
    "@org/eslint-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@org/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-dev-server": "catalog:"
  }
}
