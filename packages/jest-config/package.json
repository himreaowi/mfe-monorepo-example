{
  "name": "@org/jest-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Jest 30 preset: jsdom (+ Fetch API classes), SWC transform, Testing Library setup, fake fetch",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./setup": "./setup.cjs",
    "./jsdom-environment": "./jsdom-environment.cjs",
    "./fetch": {
      "types": "./fetch.d.ts",
      "default": "./fetch.cjs"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "setup.cjs",
    "jsdom-environment.cjs",
    "fetch.cjs",
    "fetch.d.ts"
  ],
  "types": "./index.d.ts",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\""
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  },
  "dependencies": {
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "identity-obj-proxy": "catalog:",
    "jest-environment-jsdom": "catalog:"
  },
  "peerDependencies": {
    "jest": "^30.0.0"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
