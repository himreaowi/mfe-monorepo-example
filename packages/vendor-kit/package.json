{
  "name": "@org/vendor-kit",
  "version": "1.0.0",
  "private": true,
  "description": "What external vendors get (they have no repo access): mount contract types, a standalone test host page, examples and the delivery checklist. Packed into a zip with pack:kit.",
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./contract/mount-contract.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:contract": "node scripts/generate-contract.mjs",
    "build": "node scripts/build-kit.mjs",
    "pack:kit": "node scripts/pack-kit.mjs",
    "serve": "node scripts/build-kit.mjs && node dist/vendor-kit/test-host/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=2 \"test/**/*.test.js\""
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/mf-runtime": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
