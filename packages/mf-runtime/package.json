{
  "name": "@org/mf-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Module Federation runtime glue: mfe-manifest loader + schema, initRemotes, <RemoteApp> (host) and createRemoteApp / host props (remote)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./remote": "./src/remote/index.ts",
    "./mfe-manifest.schema.json": "./src/manifest/mfe-manifest.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "generate:validator": "node scripts/generate-validator.mjs"
  },
  "dependencies": {
    "@module-federation/enhanced": "catalog:",
    "@org/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "devDependencies": {
    "@org/design-tokens": "workspace:*",
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:"
  }
}
