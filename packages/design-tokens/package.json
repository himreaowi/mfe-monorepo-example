{
  "name": "@org/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens (CSS custom properties for light/dark), global styles, theme types and constants",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./global.scss": "./src/global.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
