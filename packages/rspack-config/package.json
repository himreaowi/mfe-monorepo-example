{
  "name": "@org/rspack-config",
  "version": "0.1.0",
  "private": true,
  "description": "Rspack + Module Federation 2 config factories: createShellConfig / createRemoteConfig",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./tier1": {
      "types": "./src/index.d.ts",
      "default": "./src/tier1.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=120000 \"src/**/*.test.js\""
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  },
  "dependencies": {
    "@module-federation/enhanced": "catalog:",
    "@org/pwa": "workspace:*",
    "css-loader": "catalog:",
    "sass": "catalog:",
    "sass-loader": "catalog:"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0",
    "@rspack/dev-server": "^2.0.0"
  },
  "devDependencies": {
    "@org/auth": "workspace:*",
    "@org/eslint-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@org/ui": "workspace:*",
    "@rspack/core": "catalog:",
    "@rspack/dev-server": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:"
  }
}
