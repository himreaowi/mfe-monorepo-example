{
  "name": "@org/shell-intranet",
  "version": "0.0.0",
  "private": true,
  "description": "Intranet Shell: host app of the intranet zone",
  "type": "module",
  "scripts": {
    "dev": "rspack dev",
    "build": "rspack build",
    "preview": "mfe-preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "jest",
    "e2e": "playwright test"
  },
  "nx": {
    "tags": [
      "zone:intranet",
      "type:shell",
      "access:public"
    ]
  },
  "mfe": {
    "port": 3100,
    "federationName": "intranet_shell"
  },
  "dependencies": {
    "@org/auth": "workspace:*",
    "@org/design-tokens": "workspace:*",
    "@org/http-client": "workspace:*",
    "@org/mf-runtime": "workspace:*",
    "@org/pwa": "workspace:*",
    "@org/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/playwright-config": "workspace:*",
    "@org/rspack-config": "workspace:*",
    "@org/scripts": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@rspack/dev-server": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
