{
  "name": "@org/intranet-it-helpdesk",
  "version": "0.0.0",
  "private": true,
  "description": "It Helpdesk: external module adapter of the intranet zone (public)",
  "type": "module",
  "scripts": {
    "dev": "webpack serve",
    "build": "webpack build",
    "preview": "mfe-preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "nx": {
    "tags": [
      "zone:intranet",
      "type:remote",
      "access:public",
      "kind:external"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          {
            "projects": [
              "@org/mock-api"
            ],
            "target": "serve:intranet"
          },
          {
            "projects": [
              "@org/example-vendors"
            ],
            "target": "serve:intranet"
          }
        ]
      }
    }
  },
  "mfe": {
    "port": 3112,
    "federationName": "intranet_it_helpdesk"
  },
  "dependencies": {
    "@org/auth": "workspace:*",
    "@org/design-tokens": "workspace:*",
    "@org/http-client": "workspace:*",
    "@org/mf-runtime": "workspace:*",
    "@org/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/scripts": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@org/webpack-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:",
    "webpack-dev-server": "catalog:"
  }
}
