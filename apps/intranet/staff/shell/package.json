{
  "name": "@org/shell-staff",
  "version": "0.0.0",
  "private": true,
  "description": "Staff Portal: host app (shell) of the intranet zone",
  "type": "module",
  "scripts": {
    "dev": "mfe-dev-manifest --shell-dir . && webpack serve",
    "build": "webpack build",
    "preview": "mfe-preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "jest",
    "e2e": "playwright test"
  },
  "nx": {
    "tags": [
      "zone:intranet",
      "type:shell",
      "access:public"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          {
            "projects": [
              "@org/mock-api"
            ],
            "target": "serve:intranet"
          }
        ]
      }
    }
  },
  "mfe": {
    "port": 3101,
    "federationName": "intranet_shell_staff",
    "basePath": "/",
    "devManifest": {
      "auth": {
        "mock": true
      },
      "settings": {
        "apiBaseUrl": "/api"
      },
      "remotes": {
        "intranet_it_helpdesk": {
          "props": {
            "vendor": {
              "url": "http://localhost:3192/helpdesk/1.0.0/mount.js",
              "format": "esm",
              "config": {
                "apiBaseUrl": "http://localhost:3190/api"
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "@org/auth": "workspace:*",
    "@org/design-tokens": "workspace:*",
    "@org/http-client": "workspace:*",
    "@org/mf-runtime": "workspace:*",
    "@org/pwa": "workspace:*",
    "@org/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/playwright-config": "workspace:*",
    "@org/scripts": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@org/webpack-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:",
    "webpack-dev-server": "catalog:"
  }
}
