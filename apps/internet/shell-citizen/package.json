{
  "name": "@org/shell-citizen",
  "version": "0.0.0",
  "private": true,
  "description": "Citizen Portal: host app (shell) of the internet zone",
  "type": "module",
  "scripts": {
    "dev": "mfe-dev-manifest --shell-dir . && rspack dev",
    "build": "rspack build",
    "preview": "mfe-preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "jest",
    "e2e": "playwright test"
  },
  "nx": {
    "tags": [
      "zone:internet",
      "type:shell",
      "access:public"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          {
            "projects": [
              "@org/mock-api"
            ],
            "target": "serve:internet"
          }
        ]
      }
    }
  },
  "mfe": {
    "port": 3201,
    "federationName": "internet_shell_citizen",
    "basePath": "/citizen",
    "devManifest": {
      "auth": {
        "mock": true
      },
      "settings": {
        "apiBaseUrl": "/citizen/api"
      },
      "remotes": {
        "internet_payments": {
          "props": {
            "vendor": {
              "url": "http://localhost:3292/payments/2.3.1/element.js",
              "format": "web-component",
              "tagName": "bright-checkout",
              "config": {
                "title": "Pay your dog licence",
                "description": "Dog licence renewal 2027",
                "amount": 1500,
                "currency": "SGD"
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "@org/auth": "workspace:*",
    "@org/design-tokens": "workspace:*",
    "@org/http-client": "workspace:*",
    "@org/mf-runtime": "workspace:*",
    "@org/pwa": "workspace:*",
    "@org/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@org/eslint-config": "workspace:*",
    "@org/jest-config": "workspace:*",
    "@org/playwright-config": "workspace:*",
    "@org/rspack-config": "workspace:*",
    "@org/scripts": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@rspack/dev-server": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
