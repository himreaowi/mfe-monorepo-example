{
  "name": "@org/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "App tools shared by the workspace: zone/port data (used by the generators) and the mfe-preview static server",
  "type": "module",
  "exports": {
    ".": "./src/zones.js",
    "./zones": "./src/zones.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "mfe-preview": "./bin/mfe-preview.js"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "nx": {
    "tags": [
      "type:tool"
    ]
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
