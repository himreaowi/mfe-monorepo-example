{
  "name": "@org/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Repo guardrails (check-versions, check-apps) and the mfe-preview static server",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./zones": "./src/zones.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "mfe-check": "./bin/check.js",
    "mfe-preview": "./bin/mfe-preview.js",
    "mfe-e2e": "./bin/e2e.js"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.js\""
  },
  "nx": {
    "tags": [
      "type:tool"
    ]
  },
  "dependencies": {
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
