{
  "name": "@org/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Repo guardrails (check-versions, check-apps), dev manifest generator, list-apps (CI matrix, affected apps), e2e runner and the mfe-preview static server",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./zones": "./src/zones.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "mfe-check": "./bin/check.js",
    "mfe-preview": "./bin/mfe-preview.js",
    "mfe-dev": "./bin/dev.js",
    "mfe-e2e": "./bin/e2e.js",
    "mfe-apps": "./bin/list-apps.js",
    "mfe-validate-manifest": "./bin/validate-manifest.js",
    "mfe-dev-manifest": "./bin/dev-manifest.js"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.js\""
  },
  "nx": {
    "tags": [
      "type:tool"
    ],
    "implicitDependencies": [
      "@org/mf-runtime"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/deploy/**/*"
        ]
      }
    }
  },
  "dependencies": {
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
