// Entry of the shell. Module Federation starts asynchronously (experiments.asyncStartup in
// @org/rspack-config): the shared singletons (react, react-dom, react-router, @org/ui, @org/auth)
// are negotiated before this module runs, so it imports them directly.
import '@org/design-tokens/global.scss';
// after the tokens: shell-wide global styles (header colours: src/layouts/ShellLayout)
import './styles/shell.scss';
import { StrictMode } from 'react';
import { createRoot } from 'react-dom/client';
import { loadAuthClient } from '@org/auth';
import { initRemotes, loadMfeManifest, mfeManifestUrl } from '@org/mf-runtime';
import { registerPwa } from '@org/pwa';
import { ThemeProvider } from '@org/ui';
import { App } from './app/App';
import { BASE_PATH } from './core/constants/app';
import { StartupError } from './features/startup';

async function start() {
  const container = document.getElementById('root');
  if (!container) throw new Error('#root element not found');
  const root = createRoot(container);

  // Production builds only (the service worker is generated by the production build); scoped
  // to this shell's base path, so shells sharing a domain never control each other's pages.
  registerPwa({ basePath: BASE_PATH });

  try {
    // the shell's own manifest: <base path>/mfe-manifest.json (per environment, DevOps)
    const manifest = await loadMfeManifest({ url: mfeManifestUrl(BASE_PATH) });
    initRemotes(manifest);
    // BFF session client from manifest "auth"; { "mock": true } = dev-only mock (dropped from
    // production builds); no "auth" = sign-in disabled, private routes stay closed.
    const authClient = await loadAuthClient(manifest.auth);
    root.render(
      <StrictMode>
        <App manifest={manifest} authClient={authClient} />
      </StrictMode>,
    );
  } catch (error) {
    root.render(
      <StrictMode>
        <ThemeProvider>
          <StartupError error={error} />
        </ThemeProvider>
      </StrictMode>,
    );
  }
}

void start();
