// Landing page of a shell that requires sign-in. Values from @org/design-tokens.
.landing {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-4);
  max-width: 40rem;
  margin: var(--space-8) auto;
}

.title {
  margin: 0;
}

.text {
  margin: 0;
  color: var(--color-text-muted);
}

.error {
  margin: 0;
  color: var(--color-danger);
}
