import '@org/design-tokens/global.scss';
import { StrictMode } from 'react';
import { createRoot } from 'react-dom/client';
import { initRemotes, loadMfeManifest } from '@org/mf-runtime';
import { registerPwa } from '@org/pwa';
import { ThemeProvider } from '@org/ui';
import { App } from './app/App';
import { StartupError } from './features/startup';

async function start() {
  const container = document.getElementById('root');
  if (!container) throw new Error('#root element not found');
  const root = createRoot(container);

  // Production builds only (the service worker is generated by the production build).
  registerPwa();

  try {
    const manifest = await loadMfeManifest();
    initRemotes(manifest);
    root.render(
      <StrictMode>
        <App manifest={manifest} />
      </StrictMode>,
    );
  } catch (error) {
    root.render(
      <StrictMode>
        <ThemeProvider>
          <StartupError error={error} />
        </ThemeProvider>
      </StrictMode>,
    );
  }
}

void start();
