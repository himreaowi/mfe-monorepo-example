import { useEffect, useRef, useState, type FormEvent } from 'react';
import { Alert, Button, TextField } from '@org/ui';
import { FEDERATION_NAME } from '@/core/constants/app';
import type { CreateItemMutation } from '@/hooks/useCreateItem';
import type { ItemFieldErrors } from '@/types/item';
import { describeError, readFieldErrors } from '@/utils/itemErrors';
import { validateItemDraft } from '@/utils/validation';
import styles from './AddItemForm.module.scss';

const NAME_ID = `${FEDERATION_NAME}-item-name`;

/**
 * The form pattern of docs/coding-conventions.md: validate on submit, then an error summary
 * (focused, links to the fields) plus an error next to each field; server 422 errors land in
 * the same places; while sending, the submit button shows `loading` (it keeps focus).
 * Fields and messages come from @org/ui (TextField wires label, error and aria-* itself).
 *
 * It owns no request: `createItem` comes from the page (`useCreateItem()`) and says when it is
 * sending; the form keeps only its own UI state (field value, errors).
 */
export function AddItemForm({ createItem }: { createItem: CreateItemMutation }) {
  const [name, setName] = useState('');
  const [errors, setErrors] = useState<ItemFieldErrors>({});
  const [formError, setFormError] = useState('');
  const [status, setStatus] = useState('');
  const [failedSubmits, setFailedSubmits] = useState(0);
  const summaryRef = useRef<HTMLDivElement>(null);
  const nameRef = useRef<HTMLInputElement>(null);

  // move focus to the summary after each failed submit
  useEffect(() => {
    if (failedSubmits > 0) summaryRef.current?.focus();
  }, [failedSubmits]);

  const showErrors = (next: ItemFieldErrors) => {
    setErrors(next);
    setFailedSubmits((n) => n + 1);
  };

  function onSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setStatus('');
    setFormError('');
    const draft = { name: name.trim() };
    const clientErrors = validateItemDraft(draft);
    if (Object.keys(clientErrors).length > 0) {
      showErrors(clientErrors);
      return;
    }
    setErrors({});
    createItem.mutate(draft, {
      onSuccess: (item) => {
        setName('');
        setStatus(`Added “${item.name}”.`);
      },
      onError: (error) => {
        const serverErrors = readFieldErrors(error);
        if (serverErrors) showErrors(serverErrors);
        else setFormError(describeError(error, 'Could not add the item'));
      },
    });
  }

  const fieldErrors = Object.entries(errors).filter(([, message]) => message);

  return (
    <form
      className={styles.form}
      onSubmit={onSubmit}
      noValidate
      aria-labelledby="demo-add-item-title"
    >
      <h3 id="demo-add-item-title" className={styles.formTitle}>
        Add an item
      </h3>
      {fieldErrors.length > 0 ? (
        <Alert
          ref={summaryRef}
          variant="error"
          title="There is a problem"
          headingLevel={4}
          className={styles.errorSummary}
          tabIndex={-1}
          data-testid="error-summary"
        >
          <ul>
            {fieldErrors.map(([field, message]) => (
              <li key={field}>
                <a
                  href={`#${NAME_ID}`}
                  onClick={(event) => {
                    event.preventDefault();
                    nameRef.current?.focus();
                  }}
                >
                  {message}
                </a>
              </li>
            ))}
          </ul>
        </Alert>
      ) : null}
      {formError ? <Alert variant="error">{formError}</Alert> : null}
      <TextField
        ref={nameRef}
        id={NAME_ID}
        label="Name"
        name="name"
        className={styles.field}
        value={name}
        autoComplete="off"
        error={errors.name}
        onChange={(event) => setName(event.target.value)}
      />
      <div className={styles.row}>
        <Button type="submit" loading={createItem.isPending}>
          {createItem.isPending ? 'Adding…' : 'Add item'}
        </Button>
        <p className={styles.copy} role="status">
          {status}
        </p>
      </div>
    </form>
  );
}
