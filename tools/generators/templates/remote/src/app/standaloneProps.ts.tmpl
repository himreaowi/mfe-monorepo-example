import type { HostProps } from '@org/mf-runtime/remote';

/**
 * Mock host props for standalone mode (what the shell would pass). In development `apiBaseUrl`
 * is the zone's mock API (tools/mock-api, started by `pnpm exec nx dev __PACKAGE_NAME__` and
 * `pnpm dev:__ZONE__`); production builds drop that branch.
 */
export const standaloneProps: Partial<HostProps> = {
  title: '__APP_TITLE__',
  user: { id: 'dev-user', name: 'Dev User' },
  settings:
    process.env.NODE_ENV !== 'production'
      ? { apiBaseUrl: '__MOCK_API_URL__' }
      : {},
};
