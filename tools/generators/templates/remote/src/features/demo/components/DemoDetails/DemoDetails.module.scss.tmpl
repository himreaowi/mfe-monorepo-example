.panel {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-6);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.title {
  margin: 0;
  font-size: 1.5rem;
}

.copy {
  margin: 0;
  color: var(--color-text-muted);
}
