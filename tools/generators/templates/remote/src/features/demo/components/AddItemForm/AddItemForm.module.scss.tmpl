.form {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  width: 100%;
}

.formTitle {
  margin: var(--space-2) 0 0;
  font-size: 1.0625rem;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  align-items: center;
}

.copy {
  margin: 0;
  color: var(--color-text-muted);
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  max-width: 28rem;

  label {
    font-weight: 600;
  }
}

.input {
  min-height: 2.5rem;
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--color-text-muted);
  border-radius: var(--radius);
  background: var(--color-bg);
  color: var(--color-text);
  font: inherit;

  &:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  &[aria-invalid='true'] {
    border: 2px solid var(--color-danger);
  }
}

.error,
.fieldError {
  margin: 0;
  color: var(--color-danger);
  font-weight: 600;
}

.error {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: center;
}

.errorSummary {
  padding: var(--space-4);
  border: 3px solid var(--color-danger);
  border-radius: var(--radius);
  background: var(--color-surface);

  &:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-6);
  }

  a {
    color: var(--color-danger);
    font-weight: 600;
  }
}

.summaryTitle {
  margin: 0;
  font-size: 1rem;
}

.visuallyHidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
