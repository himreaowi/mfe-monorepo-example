.form {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  width: 100%;
}

.formTitle {
  margin: var(--space-2) 0 0;
  font-size: 1.0625rem;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  align-items: center;
}

.copy {
  margin: 0;
  color: var(--color-text-muted);
}

.field {
  max-width: 28rem;
}

.errorSummary {
  &:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  ul {
    margin: 0;
    padding-left: var(--space-6);
  }

  a {
    color: var(--color-danger);
    font-weight: 600;
  }
}
