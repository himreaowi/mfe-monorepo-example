import { act, waitFor } from '@testing-library/react';
import type { ReactNode } from 'react';
import { API_NOT_CONFIGURED } from '@org/http-client';
import { HostPropsProvider } from '@org/mf-runtime/remote';
import { renderHookWithQuery } from '@org/query/test';
import { listItems } from '@/api/itemsApi';
import { useItems } from './useItems';

// Hook tests mock the api/ module: no HTTP here (docs/testing.md).
jest.mock('@/api/itemsApi', () => ({
  ...jest.requireActual('@/api/itemsApi'),
  listItems: jest.fn(),
}));
const listItemsMock = jest.mocked(listItems);

function withSettings(settings: Record<string, unknown>) {
  return function Wrapper({ children }: { children: ReactNode }) {
    return (
      <HostPropsProvider value={{ embedded: true, basePath: '/x', settings }}>
        {children}
      </HostPropsProvider>
    );
  };
}
const api = withSettings({ apiBaseUrl: 'http://api.test/api' });

describe('useItems', () => {
  beforeEach(() => listItemsMock.mockReset());

  it('loads the items (pending → success) and passes the abort signal on', async () => {
    listItemsMock.mockResolvedValue([{ id: 1, name: 'First', description: '' }]);
    const { result } = renderHookWithQuery(() => useItems(), { wrapper: api });
    expect(result.current.status).toBe('pending');
    await waitFor(() => expect(result.current.status).toBe('success'));
    expect(result.current.data).toEqual([
      { id: 1, name: 'First', description: '' },
    ]);
    expect(listItemsMock.mock.calls[0][1]).toBeInstanceOf(AbortSignal);
  });

  it('reports an error; refetch() tries again', async () => {
    const failure = new TypeError('Failed to fetch');
    listItemsMock.mockRejectedValueOnce(failure).mockResolvedValueOnce([]);
    const { result } = renderHookWithQuery(() => useItems(), { wrapper: api });
    await waitFor(() => expect(result.current.status).toBe('error'));
    expect(result.current.error).toBe(failure);
    await act(() => result.current.refetch());
    await waitFor(() => expect(result.current.status).toBe('success'));
  });

  it('fails without calling the API when none is configured', async () => {
    const { result } = renderHookWithQuery(() => useItems(), {
      wrapper: withSettings({}),
    });
    await waitFor(() => expect(result.current.status).toBe('error'));
    expect(result.current.error?.message).toBe(API_NOT_CONFIGURED);
    expect(listItemsMock).not.toHaveBeenCalled();
  });
});
