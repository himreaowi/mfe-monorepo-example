import { Demo } from '@/components/Demo/Demo';
import { DemoItems } from '@/components/DemoItems/DemoItems';
import { ItemPicker } from '@/components/ItemPicker/ItemPicker';
import { SelectionSummary } from '@/components/SelectionSummary/SelectionSummary';
import { useCreateItem } from '@/hooks/useCreateItem';
import { useItems } from '@/hooks/useItems';
import { DemoProvider } from '@/state/DemoContext';

/**
 * Page-level data fetching: the page calls the data hooks and passes their results
 * down; the components only display. Every API call of this page is visible
 * here (docs/coding-conventions.md "Data fetching").
 *
 * `<DemoProvider>` holds the UI state shared by several components (the selection:
 * ItemPicker changes it, SelectionSummary shows it); the items themselves stay API data from
 * `useItems()` (docs/coding-conventions.md "State management").
 */
export function OverviewPage() {
  const items = useItems();
  const createItem = useCreateItem();
  return (
    <div data-testid="overview-page">
      <DemoProvider>
        <Demo>
          <DemoItems items={items} createItem={createItem} />
          {items.status === 'success' && items.data.length > 0 ? (
            <>
              <ItemPicker items={items.data} />
              <SelectionSummary />
            </>
          ) : null}
        </Demo>
      </DemoProvider>
    </div>
  );
}
