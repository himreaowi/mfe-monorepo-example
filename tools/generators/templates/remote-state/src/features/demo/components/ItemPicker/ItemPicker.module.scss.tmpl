.picker {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin: 0;
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
}

.legend {
  padding: 0 var(--space-1);
  font-weight: 600;
}

.option {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  min-height: 1.5rem;

  input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-accent);
  }
}
