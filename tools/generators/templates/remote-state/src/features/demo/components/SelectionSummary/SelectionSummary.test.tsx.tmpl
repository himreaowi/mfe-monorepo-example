import { render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { DemoProvider } from '../../state/DemoContext';
import { SelectionSummary } from './SelectionSummary';

describe('SelectionSummary', () => {
  it('says when nothing is selected', () => {
    render(
      <DemoProvider>
        <SelectionSummary />
      </DemoProvider>,
    );
    expect(screen.getByRole('status')).toHaveTextContent('No items selected');
    expect(screen.queryByRole('button')).toBeNull();
  });

  it('counts the selection and clears it', async () => {
    render(
      <DemoProvider initialState={{ selectedIds: [1, 2] }}>
        <SelectionSummary />
      </DemoProvider>,
    );
    expect(screen.getByRole('status')).toHaveTextContent('2 items selected');
    await userEvent.click(
      screen.getByRole('button', { name: 'Clear selection' }),
    );
    expect(screen.getByRole('status')).toHaveTextContent('No items selected');
  });
});
