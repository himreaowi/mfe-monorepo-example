.adapter {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.header {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: center;
}

.title {
  margin: 0;
  font-size: 1.5rem;
}

.events {
  padding: var(--space-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
}

.eventsTitle {
  margin: 0 0 var(--space-2);
  font-size: 1rem;
}

.muted {
  margin: 0;
  color: var(--color-text-muted);
}

.list {
  margin: 0;
  padding-left: var(--space-6);
  font-family: ui-monospace, monospace;
  font-size: 0.8125rem;

  [data-kind='error'] {
    color: var(--color-danger);
  }
}
